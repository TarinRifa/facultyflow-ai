NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
# Next.js expands $ references; escape literal dollar signs as \$.
SUPABASE_DB_PASSWORD=
# URL-encode special characters in the connection URL password.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only; never use in browser code or routine user task queries.
SUPABASE_SERVICE_ROLE_KEY=
# Local flag only; does not change Supabase Auth settings.
ALLOW_UNVERIFIED_SIGNUPS=true
GEMINI_API_KEY=
GEMINI_MODEL=
APP_TIMEZONE=Asia/Dhaka
